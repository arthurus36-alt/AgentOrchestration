@@ -0,0 +1,125 @@
+import pytest
+
+from src.orchestrator.workflow import (
+    StepStatus,
+    WorkflowManager,
+    WorkflowStep,
+)
+
+
+def test_partial_rollback_blocks_downstream_and_keeps_execution_state():
+    calls = []
+
+    def prepare():
+        calls.append("prepare")
+        return "prepared"
+
+    def fail_dispatch():
+        calls.append("dispatch")
+        raise RuntimeError("dispatch-secret-456")
+
+    def downstream():
+        calls.append("downstream")
+
+    def fail_compensation():
+        calls.append("undo-prepare")
+        raise RuntimeError("private-token-123")
+
+    manager = WorkflowManager()
+    workflow = manager.create_workflow("partial rollback")
+    prepare_step = WorkflowStep(
+        "prepare",
+        prepare,
+        compensate=fail_compensation,
+    )
+    dispatch_step = WorkflowStep("dispatch", fail_dispatch)
+    downstream_step = WorkflowStep("downstream", downstream)
+
+    workflow.add_step(prepare_step)
+    workflow.add_step(dispatch_step)
+    workflow.add_step(downstream_step)
+
+    assert manager.execute_workflow(workflow.id) is False
+
+    assert calls == ["prepare", "dispatch", "undo-prepare"]
+    assert workflow.status == StepStatus.FAILED
+    assert prepare_step.status == StepStatus.COMPLETED
+    assert prepare_step.compensation_status == "failed"
+    assert prepare_step.compensation_error == "RuntimeError"
+    assert dispatch_step.status == StepStatus.FAILED
+    assert dispatch_step.error == "RuntimeError"
+    assert downstream_step.status == StepStatus.SKIPPED
+    assert downstream_step.error == "blocked_after_partial_rollback"
+
+    block_events = [
+        event
+        for event in workflow.audit_events
+        if event["event"] == "downstream_blocked_after_partial_rollback"
+    ]
+    assert block_events == [
+        {
+            "event": "downstream_blocked_after_partial_rollback",
+            "workflow_id": workflow.id,
+            "failed_step_id": dispatch_step.id,
+            "failed_step_name": "dispatch",
+            "failure_type": "RuntimeError",
+            "rollback_failed_step_ids": [prepare_step.id],
+            "rollback_failed_step_names": ["prepare"],
+            "blocked_step_ids": [downstream_step.id],
+            "blocked_step_names": ["downstream"],
+            "reason": "partial_rollback",
+        }
+    ]
+    assert workflow.metrics["compensation_failures"] == 1
+    assert workflow.metrics["partial_rollback_blocks"] == 1
+
+    audit_blob = repr(workflow.audit_events)
+    assert "private-token-123" not in audit_blob
+    assert "dispatch-secret-456" not in audit_blob
+
+
+def test_workflow_rejects_late_step_registration_after_failed_dispatch():
+    manager = WorkflowManager()
+    workflow = manager.create_workflow("closed after dispatch")
+    workflow.add_step(
+        WorkflowStep(
+            "prepare",
+            lambda: "ok",
+            compensate=lambda: (_ for _ in ()).throw(RuntimeError("secret")),
+        )
+    )
+    workflow.add_step(
+        WorkflowStep(
+            "dispatch",
+            lambda: (_ for _ in ()).throw(RuntimeError("boom")),
+        )
+    )
+
+    assert manager.execute_workflow(workflow.id) is False
+
+    with pytest.raises(RuntimeError, match="cannot add steps"):
+        workflow.add_step(WorkflowStep("late downstream", lambda: "unsafe"))
+
+
+def test_compensation_can_receive_completed_step_result():
+    calls = []
+    manager = WorkflowManager()
+    workflow = manager.create_workflow("result aware rollback")
+    compensated_step = WorkflowStep(
+        "reserve",
+        lambda: "reservation-id",
+        compensate=lambda result: calls.append(f"undo:{result}"),
+    )
+    workflow.add_step(compensated_step)
+    workflow.add_step(
+        WorkflowStep(
+            "dispatch",
+            lambda: (_ for _ in ()).throw(RuntimeError("stop")),
+        )
+    )
+
+    assert manager.execute_workflow(workflow.id) is False
+
+    assert calls == ["undo:reservation-id"]
+    assert compensated_step.status == StepStatus.COMPLETED
+    assert compensated_step.compensation_status == "completed"
