@@ -0,0 +1,50 @@
+import asyncio
+import pytest
+from src.orchestrator.scheduler import TaskScheduler, PriorityQueue
+
+class TestTaskSchedulerDeadLetterIdempotent:
+    def test_dead_letter_write_idempotent(self):
+        scheduler = TaskScheduler()
+        task = {"type": "test", "retries": 2}
+        task_id = scheduler.enqueue(task)
+        
+        dequeued = asyncio.run(scheduler.dequeue())
+        assert dequeued["id"] == task_id
+        
+        # Will reach 3 retries and be pushed to dead queue explicitly or implicitly
+        # fail() returns False when terminal
+        assert scheduler.fail(task_id, queue="dead") is False
+        
+        # Verify it's marked terminal
+        assert scheduler._is_already_terminal(task_id)
+        
+        # Verify idempotent acknowledgement (calling fail again)
+        assert scheduler.fail(task_id, queue="dead") is False
+        
+        audit = scheduler.audit_log()
+        assert audit[-1]["decision"] == "dead_letter_idempotent"
+
+    def test_dead_letter_write_failure_rollback(self, monkeypatch):
+        scheduler = TaskScheduler(queue_capacities={"default": 1, "dead": 1})
+        task = {"type": "test", "retries": 2}
+        task_id = scheduler.enqueue(task)
+        dequeued = asyncio.run(scheduler.dequeue())
+        
+        dead_queue = PriorityQueue()
+        def fail_push(_task, priority=0):
+            raise RuntimeError("dead letter store full")
+            
+        monkeypatch.setattr(dead_queue, "push", fail_push)
+        scheduler._queues["dead"] = dead_queue
+        
+        with pytest.raises(RuntimeError, match="dead letter store full"):
+            # Because it evaluates retries = 3 and then attempts to enqueue to "dead",
+            # raising the exception
+            scheduler.fail(task_id, queue="dead")
+            
+        # Verify rollback preserved in-flight and capacity
+        assert task_id in scheduler._in_flight
+        assert scheduler._in_flight[task_id]["retries"] == 2
+        assert not scheduler._is_already_terminal(task_id)
+        
+        assert scheduler.capacity_snapshot()["default"]["used"] == 1
