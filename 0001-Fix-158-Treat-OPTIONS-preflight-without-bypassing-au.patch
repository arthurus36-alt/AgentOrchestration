diff --git a/src/api/middleware.py b/src/api/middleware.py
index c200929..df980e8 100644
--- a/src/api/middleware.py
+++ b/src/api/middleware.py
@@ -12,6 +12,9 @@ logger = logging.getLogger(__name__)
 
 class AuthMiddleware(BaseHTTPMiddleware):
     async def dispatch(self, request: Request, call_next: Callable) -> Response:
+        if request.method == "OPTIONS":
+            return await call_next(request)
+
         if request.url.path.startswith("/api/v2") and request.url.path != "/api/v2/auth/token":
             token = request.headers.get("Authorization", "")
             if not token.startswith("Bearer "):
diff --git a/tests/test_middleware_cors.py b/tests/test_middleware_cors.py
new file mode 100644
index 0000000..611f2d7
--- /dev/null
+++ b/tests/test_middleware_cors.py
@@ -0,0 +1,34 @@
+import pytest
+from fastapi.testclient import TestClient
+
+from src.api.server import create_app
+from src.agent import AgentRegistry
+from src.api import routes
+
+def make_client():
+    routes.registry = AgentRegistry()
+    return TestClient(create_app())
+
+def test_cors_preflight_bypasses_auth():
+    client = make_client()
+    # Mocking standard CORS preflight
+    response = client.options(
+        "/api/v2/agents",
+        headers={
+            "Origin": "http://localhost:3000",
+            "Access-Control-Request-Method": "GET"
+        }
+    )
+    # Shouldn't hit 401 Unauthorized
+    assert response.status_code == 200
+    assert "access-control-allow-origin" in response.headers
+
+def test_real_request_enforces_auth():
+    client = make_client()
+    response = client.get("/api/v2/agents")
+    assert response.status_code == 401
+    
+def test_real_request_passes_with_auth():
+    client = make_client()
+    response = client.get("/api/v2/agents", headers={"Authorization": "Bearer token"})
+    assert response.status_code == 200
