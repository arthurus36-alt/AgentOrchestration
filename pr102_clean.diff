+    def test_due_scheduled_task_dequeues_with_original_id(self):
+        task_id = self.scheduler.schedule({"type": "delayed"}, delay=0)
+
+        task = asyncio.run(self.scheduler.dequeue())
+
+        assert task is not None
+        assert task["id"] == task_id
+        assert task["lifecycle"] == "in_flight"
+
+    def test_reschedule_in_flight_task_is_rejected_and_audited(self):
+        task_id = self.scheduler.schedule(
+            {
+                "type": "delayed",
+                "payload": {"secret": "private-runtime-data"},
+            },
+            delay=0,
+        )
+        task = asyncio.run(self.scheduler.dequeue())
+        assert task["id"] == task_id
+
+        assert self.scheduler.reschedule(task_id, delay=0) is False
+
+        assert task_id in self.scheduler._in_flight
+        audit_record = self.scheduler.audit_records()[-1]
+        assert audit_record["decision"] == "reject"
+        assert audit_record["task_id"] == task_id
+        assert audit_record["reason"] == "task_not_scheduled"
+        assert "private-runtime-data" not in repr(audit_record)
+
+    def test_reschedule_stale_revision_is_rejected(self):
