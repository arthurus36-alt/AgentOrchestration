--- /dev/null
+++ b/tests/test_webhook_delivery.py
@@ -0,0 +1,167 @@
+import pytest
+
+from src.orchestrator.webhooks import WebhookDeliveryService
+
+
+def test_valid_delivery_filters_internal_run_metadata():
+    service = WebhookDeliveryService()
+    endpoint = service.register_endpoint(
+        "workspace-a",
+        "https://hooks.example.com/agent-events",
+        secret="secret-v1",
+    )
+
+    record = service.deliver(
+        endpoint.id,
+        "workspace-a",
+        "run.completed",
+        {
+            "run_id": "run-1",
+            "status": "completed",
+            "internal_trace_id": "trace-private",
+            "_debug": {"worker": "worker-1"},
+            "metadata": {
+                "visible": "yes",
+                "internal_queue": "q-private",
+                "_worker": "worker-1",
+            },
+        },
+        idempotency_key="evt-1",
+    )
+
+    assert record.status == "delivered"
+    assert record.payload == {
+        "event": "run.completed",
+        "workspace_id": "workspace-a",
+        "data": {
+            "run_id": "run-1",
+            "status": "completed",
+            "metadata": {"visible": "yes"},
+        },
+    }
+
+
+def test_endpoint_url_is_validated_before_persistence():
+    service = WebhookDeliveryService()
+
+    with pytest.raises(ValueError, match="http"):
+        service.register_endpoint("workspace-a", "file:///tmp/hook", secret="secret-v1")
+
+    assert service.endpoints("workspace-a") == []
+
+
+def test_rejects_disabled_and_cross_workspace_delivery():
+    service = WebhookDeliveryService()
+    endpoint = service.register_endpoint("workspace-a", "https://hooks.example.com/a", secret="v1")
+
+    cross_workspace = service.deliver(
+        endpoint.id,
+        "workspace-b",
+        "run.completed",
+        {"status": "completed", "internal_worker": "worker-1"},
+        idempotency_key="cross",
+    )
+    assert cross_workspace.status == "rejected"
+    assert cross_workspace.reason == "workspace_mismatch"
+    assert cross_workspace.payload == {}
+
+    service.disable_endpoint(endpoint.id)
+    disabled = service.deliver(
+        endpoint.id,
+        "workspace-a",
+        "run.completed",
+        {"status": "completed", "internal_worker": "worker-1"},
+        idempotency_key="disabled",
+    )
+    assert disabled.status == "rejected"
+    assert disabled.reason == "endpoint_disabled"
+    assert disabled.payload == {}
+
+
+def test_delivery_records_and_callbacks_are_idempotent_for_retries():
+    service = WebhookDeliveryService()
+    endpoint = service.register_endpoint("workspace-a", "https://hooks.example.com/a", secret="v1")
+    callbacks = []
+    sender_calls = []
+    service.register_callback("run.failed", callbacks.append)
+
+    first = service.deliver(
+        endpoint.id,
+        "workspace-a",
+        "run.failed",
+        {"status": "failed", "internal_error_id": "err-private"},
+        idempotency_key="evt-2",
+        sender=lambda endpoint, payload: sender_calls.append((endpoint.id, payload)) or 204,
+    )
+    replay = service.deliver(
+        endpoint.id,
+        "workspace-a",
+        "run.failed",
+        {"status": "failed", "internal_error_id": "err-private"},
+        idempotency_key="evt-2",
+        sender=lambda endpoint, payload: sender_calls.append((endpoint.id, payload)) or 204,
+    )
+
+    assert replay is first
+    assert first.attempts == 1
+    assert callbacks == [first]
+    assert len(sender_calls) == 1
+
+
+def test_failed_delivery_retries_with_same_public_payload():
+    service = WebhookDeliveryService()
+    endpoint = service.register_endpoint("workspace-a", "https://hooks.example.com/a", secret="v1")
+    callbacks = []
+    sender_payloads = []
+    service.register_callback("run.failed", callbacks.append)
+
+    def sender(_endpoint, payload):
+        sender_payloads.append(payload)
+        if len(sender_payloads) == 1:
+            raise TimeoutError("temporary timeout")
+        return 202
+
+    failed = service.deliver(
+        endpoint.id,
+        "workspace-a",
+        "run.failed",
+        {"status": "failed", "internal_error_id": "err-private"},
+        idempotency_key="evt-2",
+        sender=sender,
+    )
+    retried = service.deliver(
+        endpoint.id,
+        "workspace-a",
+        "run.failed",
+        {"status": "failed", "internal_error_id": "changed-private"},
+        idempotency_key="evt-2",
+        sender=sender,
+    )
+
+    assert failed.status == "failed"
+    assert failed.reason == "TimeoutError"
+    assert retried.status == "delivered"
+    assert retried.attempts == 2
+    assert sender_payloads == [retried.payload, retried.payload]
+    assert callbacks == [retried]
+
+
+def test_rotated_endpoint_rejects_stale_delivery_version():
+    service = WebhookDeliveryService()
+    endpoint = service.register_endpoint("workspace-a", "https://hooks.example.com/a", secret="v1")
+
+    rotated = service.rotate_endpoint(endpoint.id, secret="v2")
+    assert rotated.version == 2
+
+    stale = service.deliver(
+        endpoint.id,
+        "workspace-a",
+        "run.failed",
+        {"status": "failed", "internal_error_id": "err-private"},
+        idempotency_key="evt-3",
+        endpoint_version=1,
+    )
+
+    assert stale.status == "rejected"
+    assert stale.reason == "endpoint_rotated"
+    assert stale.payload == {}
