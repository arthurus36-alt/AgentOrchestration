+import pytest
+from fastapi.testclient import TestClient
+from src.api.server import create_app
+from src.api.routes import registry
+
+@pytest.fixture
+def client():
+    # Make sure we clean up the registry for tests
+    registry._agents.clear()
+    registry._index.clear()
+    app = create_app()
+    return TestClient(app)
+
+class TestBatchUpdateAtomicity:
+    def test_batch_update_all_valid(self, client):
+        r1 = client.post("/api/v2/agents?name=agent1&agent_type=test", headers={"Authorization": "Bearer token"})
+        r2 = client.post("/api/v2/agents?name=agent2&agent_type=test", headers={"Authorization": "Bearer token"})
+        id1 = r1.json()["agent_id"]
+        id2 = r2.json()["agent_id"]
+
+        resp = client.put("/api/v2/agents/batch", json=[
+            {"agent_id": id1, "config": {"key": "val1"}},
+            {"agent_id": id2, "config": {"key": "val2"}},
+        ], headers={"Authorization": "Bearer test-token"})
+        
+        assert resp.status_code == 200
+        data = resp.json()
+        assert data["updated"] == 2
+        assert registry.get(id1)["config"] == {"key": "val1"}
+        assert registry.get(id2)["config"] == {"key": "val2"}
+
+    def test_batch_update_invalid_agent_rolls_back_all(self, client):
+        r1 = client.post("/api/v2/agents?name=agent1&agent_type=test", headers={"Authorization": "Bearer token"})
+        id1 = r1.json()["agent_id"]
+        
+        # Add config to agent 1
+        client.put("/api/v2/agents/batch", json=[{"agent_id": id1, "config": {"key": "original"}}], headers={"Authorization": "Bearer test-token"})
+
+        # Try batch with one valid and one invalid
+        resp = client.put("/api/v2/agents/batch", json=[
+            {"agent_id": id1, "config": {"key": "val1_new"}},
+            {"agent_id": "invalid-id", "config": {"key": "val2"}},
+        ], headers={"Authorization": "Bearer test-token"})
+        
+        assert resp.status_code == 404
+        assert "Agent not found" in resp.json()["detail"]
+        # Verify rollback occurred (it never actually applied to valid agents since it fails phase 1)
+        assert registry.get(id1)["config"] == {"key": "original"}
+
+    def test_batch_update_empty_list_rejected(self, client):
+        resp = client.put("/api/v2/agents/batch", json=[], headers={"Authorization": "Bearer test-token"})
+        assert resp.status_code == 400
+        assert "Updates list cannot be empty" in resp.json()["detail"]
+
+    def test_batch_update_missing_agent_id_rejected(self, client):
+        r1 = client.post("/api/v2/agents?name=agent1&agent_type=test", headers={"Authorization": "Bearer token"})
+        resp = client.put("/api/v2/agents/batch", json=[
+            {"config": {"key": "val1"}},
+        ], headers={"Authorization": "Bearer test-token"})
+        assert resp.status_code == 400
+        assert "missing 'agent_id'" in resp.json()["detail"]
+
+    def test_batch_update_invalid_config_rejected(self, client):
+        r1 = client.post("/api/v2/agents?name=agent1&agent_type=test", headers={"Authorization": "Bearer token"})
+        id1 = r1.json()["agent_id"]
+        
+        resp = client.put("/api/v2/agents/batch", json=[
+            {"agent_id": id1, "config": "invalid-string"},
+        ], headers={"Authorization": "Bearer test-token"})
+        assert resp.status_code == 400
+        assert "must be a dict" in resp.json()["detail"]
+
+    def test_batch_update_invalid_status_rolls_back(self, client):
+        r1 = client.post("/api/v2/agents?name=agent1&agent_type=test", headers={"Authorization": "Bearer token"})
+        r2 = client.post("/api/v2/agents?name=agent2&agent_type=test", headers={"Authorization": "Bearer token"})
+        id1 = r1.json()["agent_id"]
+        id2 = r2.json()["agent_id"]
+
+        resp = client.put("/api/v2/agents/batch", json=[
+            {"agent_id": id1, "name": "new_name"},
+            {"agent_id": id2, "status": "invalid_status"},
+        ], headers={"Authorization": "Bearer test-token"})
+        
+        assert resp.status_code == 400
+        assert "Batch update failed, all changes rolled back" in resp.json()["detail"]
+        
+        # Verify first update rolled back
+        assert registry.get(id1)["name"] == "agent1"
