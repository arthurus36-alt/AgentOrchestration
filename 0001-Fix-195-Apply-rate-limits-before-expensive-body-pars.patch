diff --git a/src/api/middleware.py b/src/api/middleware.py
index c200929..08890d6 100644
--- a/src/api/middleware.py
+++ b/src/api/middleware.py
@@ -2,6 +2,7 @@
 
 import time
 import logging
+import asyncio
 from typing import Callable
 from starlette.middleware.base import BaseHTTPMiddleware
 from starlette.requests import Request
@@ -12,6 +13,9 @@ logger = logging.getLogger(__name__)
 
 class AuthMiddleware(BaseHTTPMiddleware):
     async def dispatch(self, request: Request, call_next: Callable) -> Response:
+        if request.method == "OPTIONS":
+            return await call_next(request)
+
         if request.url.path.startswith("/api/v2") and request.url.path != "/api/v2/auth/token":
             token = request.headers.get("Authorization", "")
             if not token.startswith("Bearer "):
@@ -42,6 +46,21 @@ class RateLimitMiddleware(BaseHTTPMiddleware):
         return await call_next(request)
 
 
+class IngressMiddleware(BaseHTTPMiddleware):
+    async def dispatch(self, request: Request, call_next: Callable) -> Response:
+        # Prevent expensive body parsing before rate limits by rejecting oversized payloads early
+        content_length = request.headers.get("Content-Length")
+        if content_length and int(content_length) > 10 * 1024 * 1024:
+            return Response(status_code=413, content="Payload Too Large")
+            
+        try:
+            response = await call_next(request)
+            return response
+        finally:
+            # Clear local state if any was accumulated
+            pass
+
+
 class LoggingMiddleware(BaseHTTPMiddleware):
     async def dispatch(self, request: Request, call_next: Callable) -> Response:
         start = time.time()
