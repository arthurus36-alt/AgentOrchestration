         agents = self._agents.values()
         if status:
             agents = [a for a in agents if a["status"] == status.value]
@@ -73,6 +91,190 @@ class AgentRegistry:
     def count(self) -> int:
         return len(self._agents)
 
+    def set_authorization_policy(
+        self,
+        agent_id: str,
+        policy: Dict[str, Iterable[str]],
+    ) -> bool:
+        agent = self._agents.get(agent_id)
+        if not agent:
+            return False
+        agent["authorization_policy"] = self._normalize_authorization_policy(
+            policy,
+        )
+        agent["authorization_revision"] += 1
+        agent["updated_at"] = time.time()
+        self._invalidate_authorization_cache(
+            agent_id,
+            agent["authorization_revision"],
+        )
+        return True
+
+    def resolve_authorized(
+        self,
+        agent_id: str,
+        principal_id: str,
+        permission: str,
+    ) -> Dict[str, Any]:
+        agent = self._agents.get(agent_id)
+        if not agent:
+            self._record_authorization_audit(
+                "authorization_resolution",
+                "deny",
+                "agent_not_found",
+                agent_id=agent_id,
+                principal_id=principal_id,
+                permission=permission,
+                authorization_revision=0,
+            )
+            raise PermissionError("Agent is not available")
+
+        revision = agent["authorization_revision"]
+        cache_key = (agent_id, principal_id, permission)
+        cached = self._resolution_cache.get(cache_key)
+        if cached and cached["authorization_revision"] != revision:
+            self._resolution_cache.pop(cache_key, None)
+            self._record_authorization_audit(
+                "authorization_cache_invalidated",
+                "defer",
+                "stale_authorization_revision",
+                agent_id=agent_id,
+                principal_id=principal_id,
+                permission=permission,
+                authorization_revision=revision,
+                invalidated_entries=1,
+            )
+            cached = None
+
+        if cached and self._has_permission(agent, principal_id, permission):
+            self._record_authorization_audit(
+                "authorization_resolution",
+                "allow",
+                "cache_hit",
+                agent_id=agent_id,
+                principal_id=principal_id,
+                permission=permission,
+                authorization_revision=revision,
+            )
+            return dict(agent)
+
+        if not self._has_permission(agent, principal_id, permission):
+            self._resolution_cache.pop(cache_key, None)
+            self._record_authorization_audit(
+                "authorization_resolution",
+                "deny",
+                "missing_permission",
+                agent_id=agent_id,
+                principal_id=principal_id,
+                permission=permission,
+                authorization_revision=revision,
+            )
+            raise PermissionError("Principal is not authorized")
+
+        self._resolution_cache[cache_key] = {
+            "agent_id": agent_id,
+            "authorization_revision": revision,
+        }
+        self._record_authorization_audit(
+            "authorization_resolution",
+            "allow",
+            "policy_match",
+            agent_id=agent_id,
+            principal_id=principal_id,
+            permission=permission,
+            authorization_revision=revision,
+        )
+        return dict(agent)
+
+    def authorization_audit(self) -> List[Dict[str, Any]]:
+        return [dict(record) for record in self._authorization_audit]
+
+    def _normalize_authorization_policy(
+        self,
+        policy: Optional[Dict[str, Iterable[str]]],
+    ) -> Dict[str, Set[str]]:
+        if policy is None:
+            return {}
+        if not isinstance(policy, dict):
+            raise ValueError("authorization policy must be a mapping")
+
+        normalized: Dict[str, Set[str]] = {}
+        for principal_id, permissions in policy.items():
+            if not isinstance(principal_id, str) or not principal_id:
+                raise ValueError("authorization principals must be named")
+            if isinstance(permissions, str) or not isinstance(
+                permissions,
+                Iterable,
+            ):
+                raise ValueError("authorization permissions must be a list")
+            normalized_permissions: Set[str] = set()
+            for permission in permissions:
+                if not isinstance(permission, str) or not permission:
+                    raise ValueError(
+                        "authorization permission entries must be named",
+                    )
+                normalized_permissions.add(permission)
+            normalized[principal_id] = normalized_permissions
+        return normalized
+
+    def _has_permission(
+        self,
+        agent: Dict[str, Any],
+        principal_id: str,
+        permission: str,
+    ) -> bool:
+        permissions = agent["authorization_policy"].get(principal_id, set())
+        return permission in permissions or "*" in permissions
+
+    def _invalidate_authorization_cache(
+        self,
+        agent_id: str,
+        authorization_revision: int,
+    ) -> None:
+        cache_keys = [
+            cache_key for cache_key in self._resolution_cache
+            if cache_key[0] == agent_id
+        ]
+        for cache_key in cache_keys:
+            self._resolution_cache.pop(cache_key, None)
+        self._record_authorization_audit(
+            "authorization_cache_invalidated",
+            "defer",
+            "permission_change",
+            agent_id=agent_id,
+            authorization_revision=authorization_revision,
+            invalidated_entries=len(cache_keys),
+        )
+
+    def _record_authorization_audit(
+        self,
+        event: str,
+        decision: str,
+        reason: str,
+        *,
+        agent_id: str,
+        authorization_revision: int,
+        principal_id: Optional[str] = None,
+        permission: Optional[str] = None,
+        invalidated_entries: Optional[int] = None,
+    ) -> None:
+        record: Dict[str, Any] = {
+            "event": event,
+            "decision": decision,
+            "reason": reason,
+            "agent_id": agent_id,
+            "authorization_revision": authorization_revision,
+        }
+        if principal_id is not None:
+            record["principal_hash"] = hashlib.sha256(
+                principal_id.encode("utf-8"),
+            ).hexdigest()[:12]
+        if permission is not None:
+            record["permission"] = permission
+        if invalidated_entries is not None:
+            record["invalidated_entries"] = invalidated_entries
+        self._authorization_audit.append(record)
+
