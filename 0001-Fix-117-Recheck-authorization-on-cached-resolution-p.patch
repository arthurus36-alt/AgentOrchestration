diff --git a/tests/test_agent_registry.py b/tests/test_agent_registry.py
index cc57374..da700b3 100644
--- a/tests/test_agent_registry.py
+++ b/tests/test_agent_registry.py
@@ -48,6 +48,55 @@ class TestAgentRegistry:
     def test_delete_nonexistent_agent(self):
         assert not self.registry.delete("nonexistent-id")
 
+    def test_cached_resolution_rechecks_policy_after_permission_change(self):
+        agent_id = self.registry.register(
+            "test-agent",
+            "worker.processor",
+            config={
+                "authorization": {"alice": ["tasks:route"]},
+                "private_token": "should-not-leak",
+            },
+        )
+
+        resolved = self.registry.resolve_authorized(
+            agent_id,
+            principal_id="alice",
+            permission="tasks:route",
+        )
+        assert resolved["id"] == agent_id
+
+        self.registry.update_status(agent_id, AgentStatus.RUNNING)
+        assert self.registry.set_authorization_policy(agent_id, {"alice": []})
+
+        with pytest.raises(PermissionError):
+            self.registry.resolve_authorized(
+                agent_id,
+                principal_id="alice",
+                permission="tasks:route",
+            )
+
+        agent = self.registry.get(agent_id)
+        assert agent["status"] == AgentStatus.RUNNING.value
+
+        audit = self.registry.authorization_audit()
+        assert any(
+            record["event"] == "authorization_cache_invalidated"
+            for record in audit
+        )
+        assert audit[-1]["event"] == "authorization_resolution"
+        assert audit[-1]["decision"] == "deny"
+        assert audit[-1]["reason"] == "missing_permission"
+        assert "alice" not in repr(audit)
+        assert "should-not-leak" not in repr(audit)
+
+    def test_register_rejects_invalid_authorization_policy(self):
+        with pytest.raises(ValueError):
+            self.registry.register(
+                "test-agent",
+                "worker.processor",
+                config={"authorization": {"alice": "tasks:route"}},
+            )
+
