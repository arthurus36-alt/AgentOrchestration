@@ -0,0 +1,89 @@
+import pytest
+from src.orchestrator.webhooks import WebhookDeliveryService
+
+class TestWebhookDelivery:
+    def test_valid_delivery_filters_internal_run_metadata(self):
+        svc = WebhookDeliveryService()
+        ep = svc.register_endpoint("ws1", "http://example.com", "secret")
+        
+        data = {
+            "public_id": "abc",
+            "_internal_trace": "hidden",
+            "internal_worker": "hidden",
+            "api_key": "hidden",
+            "nested": {
+                "safe": "visible",
+                "secret": "hidden"
+            }
+        }
+        
+        rec = svc.deliver(ep.id, "ws1", "run.completed", data, "idemp1")
+        assert rec.status == "delivered"
+        payload_data = rec.payload["data"]
+        
+        assert "public_id" in payload_data
+        assert "_internal_trace" not in payload_data
+        assert "internal_worker" not in payload_data
+        assert "api_key" not in payload_data
+        assert payload_data["nested"] == {"safe": "visible"}
+        assert "secret" not in payload_data["nested"]
+
+    def test_endpoint_url_is_validated_before_persistence(self):
+        svc = WebhookDeliveryService()
+        with pytest.raises(ValueError):
+            svc.register_endpoint("ws1", "ftp://example.com", "secret")
+
+    def test_rejects_disabled_and_cross_workspace_delivery(self):
+        svc = WebhookDeliveryService()
+        ep = svc.register_endpoint("ws1", "http://example.com", "secret")
+        
+        rec1 = svc.deliver(ep.id, "ws2", "run.completed", {}, "idemp1")
+        assert rec1.status == "rejected"
+        assert rec1.reason == "workspace_mismatch"
+        
+        svc.disable_endpoint(ep.id)
+        rec2 = svc.deliver(ep.id, "ws1", "run.completed", {}, "idemp2")
+        assert rec2.status == "rejected"
+        assert rec2.reason == "endpoint_disabled"
+
+    def test_delivery_records_and_callbacks_are_idempotent_for_retries(self):
+        svc = WebhookDeliveryService()
+        ep = svc.register_endpoint("ws1", "http://example.com", "secret")
+        
+        rec1 = svc.deliver(ep.id, "ws1", "run.completed", {"id": "1"}, "idemp1")
+        assert rec1.status == "delivered"
+        
+        rec2 = svc.deliver(ep.id, "ws1", "run.completed", {"id": "1"}, "idemp1")
+        assert rec2.status == "delivered"
+        assert rec1.id == rec2.id
+        assert rec1.attempts == rec2.attempts
+
+    def test_failed_delivery_retries_with_same_public_payload(self):
+        svc = WebhookDeliveryService()
+        ep = svc.register_endpoint("ws1", "http://example.com", "secret")
+        
+        def fail_sender(ep, payload):
+            raise RuntimeError("network error")
+            
+        def ok_sender(ep, payload):
+            return 200
+            
+        rec1 = svc.deliver(ep.id, "ws1", "run.completed", {"safe": "yes", "_hidden": "no"}, "idemp1", sender=fail_sender)
+        assert rec1.status == "failed"
+        assert rec1.attempts == 1
+        
+        rec2 = svc.deliver(ep.id, "ws1", "run.completed", {"safe": "yes", "_hidden": "no"}, "idemp1", sender=ok_sender)
+        assert rec2.status == "delivered"
+        assert rec2.attempts == 2
+        assert "_hidden" not in rec2.payload["data"]
+
+    def test_rotated_endpoint_rejects_stale_delivery_version(self):
+        svc = WebhookDeliveryService()
+        ep = svc.register_endpoint("ws1", "http://example.com", "secret")
+        
+        ep = svc.rotate_endpoint(ep.id, secret="new_secret")
+        assert ep.version == 2
+        
+        rec = svc.deliver(ep.id, "ws1", "run.completed", {}, "idemp1", endpoint_version=1)
+        assert rec.status == "rejected"
+        assert rec.reason == "endpoint_rotated"
