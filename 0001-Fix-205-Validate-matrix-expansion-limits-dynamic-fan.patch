@@ -0,0 +1,38 @@
+import pytest
+from src.orchestrator.workflow import WorkflowManager, WorkflowStep, MatrixExpansionLimitExceeded, StepStatus
+
+def test_workflow_matrix_expansion_limit_validation():
+    manager = WorkflowManager(max_matrix_size=5)
+    workflow = manager.create_workflow("matrix test")
+    
+    # Valid step
+    step1 = WorkflowStep("step1", lambda x: x * 2, matrix=[1, 2, 3])
+    # Invalid step
+    step2 = WorkflowStep("step2", lambda x: x * 2, matrix=[1, 2, 3, 4, 5, 6])
+    
+    workflow.add_step(step1)
+    workflow.add_step(step2)
+    
+    with pytest.raises(MatrixExpansionLimitExceeded, match="exceeds limit 5"):
+        manager.execute_workflow(workflow.id)
+        
+    assert workflow.status == StepStatus.FAILED
+    assert step2.status == StepStatus.FAILED
+    assert step2.error == "MatrixExpansionLimitExceeded"
+    
+    audit = manager.audit_events()
+    assert audit[-1]["event"] == "matrix_expansion_rejected"
+    assert audit[-1]["workflow_id"] == workflow.id
+
+def test_workflow_matrix_expansion_success():
+    manager = WorkflowManager(max_matrix_size=5)
+    workflow = manager.create_workflow("matrix test")
+    
+    def handler(item):
+        return item * 2
+        
+    step1 = WorkflowStep("step1", handler, matrix=[1, 2, 3])
+    workflow.add_step(step1)
+    
+    assert manager.execute_workflow(workflow.id) is True
+    assert step1.result == [2, 4, 6]
