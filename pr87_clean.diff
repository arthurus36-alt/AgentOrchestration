+# syntax=docker/dockerfile:1
+
+ARG PYTHON_VERSION=3.11-slim
+
+FROM python:${PYTHON_VERSION} AS builder
+
+ARG INTERNAL_BUILD_CHANNEL=local
+ARG INTERNAL_BUILD_REVISION=unknown
+
+ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
+    PIP_NO_CACHE_DIR=1 \
+    VIRTUAL_ENV=/opt/agent-orchestrator
+ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
+
+WORKDIR /build
+
+RUN python -m venv "${VIRTUAL_ENV}"
+
+COPY pyproject.toml README.md ./
+COPY src ./src
+
+RUN pip install --upgrade pip && \
+    pip install .
+
+FROM python:${PYTHON_VERSION} AS runtime
+
+LABEL org.opencontainers.image.title="Agent Orchestrator" \
+      org.opencontainers.image.description="Enterprise Agent Orchestration Platform API" \
+      org.opencontainers.image.version="2.4.1"
+
+ENV PATH="/opt/agent-orchestrator/bin:${PATH}" \
+    PYTHONDONTWRITEBYTECODE=1 \
+    PYTHONUNBUFFERED=1
+
+WORKDIR /app
+
+COPY --from=builder /opt/agent-orchestrator /opt/agent-orchestrator
+COPY src ./src
+
+EXPOSE 8000
+
+CMD ["uvicorn", "src.api.server:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
