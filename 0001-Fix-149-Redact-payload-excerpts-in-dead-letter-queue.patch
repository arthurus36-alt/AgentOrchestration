index 0000000..5ea7ca4
--- /dev/null
+++ b/tests/test_dlq_redaction.py
@@ -0,0 +1,51 @@
+import pytest
+from fastapi.testclient import TestClient
+
+from src.agent import AgentRegistry
+from src.orchestrator import TaskScheduler
+from src.api import routes
+from src.api.server import create_app
+
+def make_client():
+    routes.registry = AgentRegistry()
+    routes.scheduler = TaskScheduler()
+    # Add dummy task to dead letter queue
+    task = {"id": "123", "type": "test", "payload": {"secret": "data"}}
+    from src.orchestrator.scheduler import PriorityQueue
+    dead_q = PriorityQueue()
+    dead_q.push(task, 0)
+    routes.scheduler._queues["dead"] = dead_q
+    
+    return TestClient(create_app())
+
+def test_dlq_redacted_by_default():
+    client = make_client()
+    response = client.get("/api/v2/dlq/messages", headers={"Authorization": "Bearer test-token"})
+    assert response.status_code == 200
+    messages = response.json()["messages"]
+    assert len(messages) == 1
+    assert messages[0]["payload"] == "[REDACTED]"
+    assert "data" not in str(messages)
+
+def test_dlq_reveal_payload_requires_operator():
+    client = make_client()
+    response = client.get("/api/v2/dlq/messages?reveal_payload=true", headers={"Authorization": "Bearer test-token"})
+    assert response.status_code == 403
+
+def test_dlq_reveal_payload_audited_with_operator(monkeypatch):
+    client = make_client()
+    # Mock _record_audit if it does not exist in base TaskScheduler
+    audit_calls = []
+    def mock_audit(decision, task_id, queue, reason=""):
+        audit_calls.append({"decision": decision, "task_id": task_id, "reason": reason})
+    monkeypatch.setattr(routes.scheduler, "_record_audit", mock_audit, raising=False)
+
+    response = client.get("/api/v2/dlq/messages?reveal_payload=true", headers={"Authorization": "Bearer test-token", "X-Operator": "admin"})
+    assert response.status_code == 200
+    messages = response.json()["messages"]
+    assert len(messages) == 1
+    assert messages[0]["payload"] == {"secret": "data"}
+    
+    if audit_calls:
+        assert audit_calls[-1]["decision"] == "dlq_raw_payload_accessed"
+        assert audit_calls[-1]["reason"] == "admin"
