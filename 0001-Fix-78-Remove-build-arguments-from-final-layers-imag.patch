diff --git a/scripts/audit_image_metadata.py b/scripts/audit_image_metadata.py
new file mode 100644
index 0000000..a210cb1
--- /dev/null
+++ b/scripts/audit_image_metadata.py
@@ -0,0 +1,84 @@
+import argparse
+import json
+import subprocess
+from typing import Any, Dict, Iterable, List, Optional
+
+APPROVED_RUNTIME_LABELS = {
+    "org.opencontainers.image.title",
+    "org.opencontainers.image.description",
+    "org.opencontainers.image.version",
+    "org.opencontainers.image.source",
+    "org.opencontainers.image.revision",
+    "org.opencontainers.image.created",
+    "org.opencontainers.image.licenses",
+}
+
+class MetadataAuditError(RuntimeError):
+    pass
+
+def _audit_history(history, forbidden, names):
+    for entry in history:
+        created_by = entry.get("created_by", "")
+        for val in forbidden:
+            if val in created_by:
+                raise MetadataAuditError(f"Forbidden value '{val}' found in layer: {created_by}")
+        for name in names:
+            if f"ARG {name}" in created_by:
+                raise MetadataAuditError(f"Forbidden build arg '{name}' found in layer: {created_by}")
+
+def _audit_labels(label_map, forbidden, names, approved):
+    for key, val in label_map.items():
+        if key not in approved:
+            raise MetadataAuditError(f"Unapproved runtime label: {key}")
+        for f_val in forbidden:
+            if f_val in val:
+                raise MetadataAuditError(f"Forbidden value '{f_val}' found in label '{key}'")
+        for name in names:
+            if name in key or name in val:
+                raise MetadataAuditError(f"Forbidden build arg '{name}' found in label '{key}'")
+
+def audit_metadata(
+    history: Iterable[Dict[str, Any]],
+    labels: Optional[Dict[str, str]],
+    forbidden_values: Iterable[str],
+    forbidden_names: Iterable[str] = (),
+    approved_labels: Iterable[str] = APPROVED_RUNTIME_LABELS,
+) -> None:
+    forbidden = [value for value in forbidden_values if value]
+    names = [name for name in forbidden_names if name]
+    approved = set(approved_labels)
+    label_map = labels or {}
+
+    _audit_history(history, forbidden, names)
+    _audit_labels(label_map, forbidden, names, approved)
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--image", required=True)
+    parser.add_argument("--forbidden-name", action="append", default=[])
+    parser.add_argument("--forbidden-value", action="append", default=[])
+    args = parser.parse_args()
+
+    inspect_out = subprocess.check_output(["docker", "inspect", args.image])
+    inspect_data = json.loads(inspect_out)[0]
+    labels = inspect_data.get("Config", {}).get("Labels", {})
+
+    history_out = subprocess.check_output(["docker", "history", "--no-trunc", "--format", "{{json .}}", args.image])
+    history = [json.loads(line) for line in history_out.decode().strip().split("\n") if line.strip()]
+    history_entries = [{"created_by": h["CreatedBy"]} for h in history]
+
+    try:
+        audit_metadata(
+            history=history_entries,
+            labels=labels,
+            forbidden_values=args.forbidden_value,
+            forbidden_names=args.forbidden_name,
+        )
+        print("Audit passed.")
+    except MetadataAuditError as e:
+        print(f"Audit failed: {e}")
+        sys.exit(1)
+
+if __name__ == "__main__":
+    import sys
+    main()
diff --git a/tests/test_audit_image_metadata.py b/tests/test_audit_image_metadata.py
new file mode 100644
index 0000000..54cc3bf
--- /dev/null
+++ b/tests/test_audit_image_metadata.py
@@ -0,0 +1,55 @@
+import pytest
+from scripts.audit_image_metadata import audit_metadata, MetadataAuditError
+
+def test_audit_history_detects_forbidden_values():
+    history = [
+        {"created_by": "CMD [\"uvicorn\"]"},
+        {"created_by": "COPY src ./src"},
+        {"created_by": "RUN echo ci-private-channel-sentinel > channel.txt"},
+    ]
+    with pytest.raises(MetadataAuditError, match="ci-private-channel-sentinel"):
+        audit_metadata(
+            history=history,
+            labels={},
+            forbidden_values=["ci-private-channel-sentinel"]
+        )
+
+def test_audit_history_detects_forbidden_args():
+    history = [
+        {"created_by": "ARG INTERNAL_BUILD_CHANNEL"},
+    ]
+    with pytest.raises(MetadataAuditError, match="INTERNAL_BUILD_CHANNEL"):
+        audit_metadata(
+            history=history,
+            labels={},
+            forbidden_values=[],
+            forbidden_names=["INTERNAL_BUILD_CHANNEL"]
+        )
+
+def test_audit_labels_detects_unapproved_label():
+    labels = {
+        "org.opencontainers.image.title": "Agent Orchestrator",
+        "custom.internal.label": "secret",
+    }
+    with pytest.raises(MetadataAuditError, match="Unapproved runtime label"):
+        audit_metadata(
+            history=[],
+            labels=labels,
+            forbidden_values=[]
+        )
+
+def test_audit_passes_clean_metadata():
+    history = [
+        {"created_by": "CMD [\"uvicorn\"]"},
+        {"created_by": "COPY src ./src"},
+    ]
+    labels = {
+        "org.opencontainers.image.title": "Agent Orchestrator",
+    }
+    # Should not raise
+    audit_metadata(
+        history=history,
+        labels=labels,
+        forbidden_values=["secret"],
+        forbidden_names=["INTERNAL_BUILD_CHANNEL"]
+    )
